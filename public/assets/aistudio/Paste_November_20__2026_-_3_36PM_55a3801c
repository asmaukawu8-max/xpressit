  (function() {
    const maskingBtn = document.getElementById('masking-toggle-btn');
    const maskingStatus = document.getElementById('masking-status');
    const recordBtn = document.getElementById('record-master-btn');
    const pauseBtn = document.getElementById('pause-btn');

    let isShifted = true;
    let isPaused = false;

    if (maskingBtn && maskingStatus) {
      maskingBtn.addEventListener('click', function() {
        isShifted = !isShifted;
        maskingStatus.textContent = isShifted ? 'Shifted (+1 st)' : 'Mask: Deep Ambient';
      });
    }

    if (pauseBtn) {
      pauseBtn.addEventListener('click', function() {
        isPaused = !isPaused;
        const icon = pauseBtn.querySelector('.material-symbols-outlined');
        const text = pauseBtn.querySelector('span:last-child');
        if (icon && text) {
          icon.textContent = isPaused ? 'play_arrow' : 'pause';
          text.textContent = isPaused ? 'Resume' : 'Pause';
        }
      });
    }

    if (recordBtn) {
      recordBtn.addEventListener('click', function() {
        recordBtn.classList.toggle('scale-95');
      });
    }
